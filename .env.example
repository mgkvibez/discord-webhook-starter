# From Developer Portal -> your application -> General Information.
# The public key is hex, 64 characters. It is not a secret, it verifies signatures.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Only needed to register slash commands (POST /admin/register-commands).
DISCORD_BOT_TOKEN=

# Optional: register commands to one server so they appear instantly while testing.
DISCORD_GUILD_ID=

# Protects /admin/*. Generate something long: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Optional: incoming webhook URL (Channel settings -> Integrations -> Webhooks).
# This is the OTHER kind of Discord webhook: posts into a channel, no bot user.
DISCORD_WEBHOOK_URL=

# Reject signatures older than this many seconds. 0 disables the check.
DISCORD_TIMESTAMP_TOLERANCE=300
